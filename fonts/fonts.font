font = {
	name = "Debug"
	
	fontstyle = {
		style = regular
		fontfiles = "OpenSans-Semibold"
	}
}

# Also used by GUI editor
font = {
	name = "standard_font"
	
	fontstyle = {
		style = regular
		fontfiles = "OpenSans-Semibold"
	}
}

# Used by regular text	
font = {
	name = "OpenSans"
	
	fontstyle = {
		style = regular
		fontfiles = "OpenSans-Semibold"
	}
	#Also used by gui editor
	fontstyle = {
		style = bold
		fontfiles = "OpenSans-Bold"
	}
	fontstyle = {
		style = italic
		fontfiles = "OpenSans-Italic"
	}
	fontstyle = {
		style = bold|italic
		fontfiles = "OpenSans-BoldItalic"
	}
}

#fulhack - only used in JominiButton and should probably be removed from there.
# Used by most titles 
font = {
	name = "OpenSans_bold"
	
	fontstyle = {
		style = regular
		#fontfiles = "OpenSans-Bold"
		fontfiles = "Lusitana-Regular"
	}
}

#Main font
font = {
	name = "BaseFont"
	
	fontstyle = {
		style = regular
		fontfiles = "Imp19c-Regular"
	}

	fontstyle = {
		style = bold
		fontfiles = "Imp19c-Bold"
	}
}

font = {
	name = "HeaderFont"
	
	fontstyle = {
		style = regular
		fontfiles = "Imp19c-Regular"
	}
}

