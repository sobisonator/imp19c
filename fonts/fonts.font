fontfiles = {
    name = "OpenSans-Semibold"
	always_load = yes

    group = {
        languages = { "l_english" "l_french" "l_german" "l_spanish" "l_simp_chinese" }
        files = { "fonts/OpenSans-Semibold.ttf" "fonts/NotoSansCJKsc-Regular.otf" "fonts/LusitanaCyr-Regular.ttf" }
    }

    group = {
        languages = { "l_russian" }
        files = {  "fonts/LusitanaCyr-Regular.ttf" "fonts/OpenSans-Semibold.ttf" "fonts/NotoSansCJKsc-Regular.otf" }
    }
}

