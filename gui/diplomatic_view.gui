@mincategorybuttonwidth = 160
@maxcategorybuttonwidth = 160
@mincategorybuttonheight = 42
@maxcategorybuttonheight = 42
@window_width = 700
@window_height = 910

base_window = {
	name = "diplomatic_view"
	size = { @window_width @window_height }
	allow_outside = yes
	state = {
		name = _show
		on_start = "[GetVariableSystem.Set( 'diplomatic_tabs', 'diplomatic' )]"
		on_start = "[GetScriptedGui('save_selected_tag').Execute( GuiScope.SetRoot( DiplomaticView.GetTargetCountry.MakeScope ).AddScope('player', Player.MakeScope ).End )]"
		on_start = "[GetScriptedGui('player_subjects').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
		start_sound = {
			soundeffect = "event:/SFX/UI/Generic/2.0/sfx_ui_window_tab_close"
		}
	}
	
	using = main_window_template
	state = {
		name = _hide
		start_sound = {
			soundeffect = "event:/SFX/UI/Generic/2.0/sfx_ui_window_tab_close"
		}
		on_start = "[GetVariableSystem.Set( 'diplomatic_tabs', 'diplomatic' )]"
		on_start = "[GetScriptedGui('remove_player_subjects').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"

	}
	flowcontainer = {
		direction = vertical
		ignoreinvisible = yes
		widget = {
			size = { @window_width 10 }
			using = MainWindowHeaderLine
		}
		margin_widget = {
			size = { @window_width 58 }
			layoutpolicy_horizontal = expanding
			hbox = { 
				layoutpolicy_vertical = preferred
				layoutpolicy_horizontal = expanding
				spacing = -2
				margin_widget = {
					using = MainWindowHeaderContentLeft
					blockoverride "Title_text" { text = "DIPLOMACY_MENU_HEADER" }
					blockoverride "FlagOrIcon"
					{
						icon = {
							using = gold_background
							size = { 32 32 }
							modify_texture = {
								texture = "gfx/interface/icons/menu_buttons/menu_diplomacy.dds"
								blend_mode = alphamultiply
							}
						}
					}
				}
				flowcontainer = {
					category_tab_left = {
						blockoverride "MinSize" { size = { @mincategorybuttonwidth @mincategorybuttonheight } }
						blockoverride "MaxSize" { size = { @maxcategorybuttonwidth @maxcategorybuttonheight } }
						blockoverride "MinVisible" { visible = "[And( Not( GetVariableSystem.HasValue('diplomatic_tabs', 'country')), GetVariableSystem.Exists('diplomatic_tabs'))]" }
						blockoverride "MaxVisible" { visible = "[Or( GetVariableSystem.HasValue('diplomatic_tabs', 'country'), Not( GetVariableSystem.Exists('diplomatic_tabs') ) )]" }
						######## Shared Overrides
						blockoverride "Center_text" { text = "OUR_DETAILS" }
						######## Small Button Overrides
						blockoverride "On_click" {
							onclick = "[GetVariableSystem.Set('diplomatic_tabs', 'country')]"
							onclick = "[GetScriptedGui('remove_player_subjects').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
							onclick = "[GetScriptedGui('player_subjects').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
						}
					}  
					category_spacer_horizontal = { }
					category_tab_right = {
						#blockoverride "Enabled" { enabled = "[Not(And( Not( EqualTo_int32( DiplomaticView.GetTargetCountry.GetId, Player.GetId ) ), Not(DiplomaticView.GetTargetCountry.IsBarbarian) ))]" }
						blockoverride "MinSize" { size = { @mincategorybuttonwidth @mincategorybuttonheight } }
						blockoverride "MaxSize" { size = { @maxcategorybuttonwidth @maxcategorybuttonheight } }
						blockoverride "MinVisible" { visible = "[Not( GetVariableSystem.HasValue('diplomatic_tabs', 'diplomatic'))]" }
						blockoverride "MaxVisible" { visible = "[GetVariableSystem.HasValue('diplomatic_tabs', 'diplomatic')]" }
						######## Shared Overrides
						blockoverride "Center_text" { text = "DIPLOMATIC" }
						######## Small Button Overrides
						blockoverride "On_click" { onclick = "[GetVariableSystem.Set('diplomatic_tabs', 'diplomatic')]" }
					}
				}
				margin_widget = {
					using = MainWindowHeaderContentRight
					blockoverride "White_buttons" 
					{
						button_back = { 
							shortcut = "previous_window"
							onclick = "[DiplomaticView.OnPrevious]"
							tooltip = "PREVIOUS_DIPLOMATIC_VIEW"
						}
						
						button_close = {
							onclick = "[DiplomaticView.OnClose]"
							#onclick = "[GetVariableSystem.Set( 'diplomatic_tabs', 'diplomatic' )]"
							#onclick = "[GetScriptedGui('remove_player_subjects_variables_button').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
							tooltip = "CLOSE"
							shortcut = "close_window"
						}
					}
				}
			}
		}
		flowcontainer = {
			margin = { 10 0 }
			direction = vertical
			spacing = 5
			visible = "[GetVariableSystem.HasValue( 'diplomatic_tabs', 'country' )]"
			margin_widget = {
				size = { 680 100 }
				datacontext = "[DiplomaticView.GetPlayer]"
				flowcontainer = {
					direction = vertical
					spacing = 5
					widget = {
						size = { 680 50 }
						using = background_widget
						flowcontainer = {
							margin = { 5 5 }
							spacing = 5
							ignoreinvisible = yes
							widget = {
								size = { 60 40 }
								new_country_flag = {
									datacontext = "[DiplomaticView.GetPlayer]"
									tooltip = "[Country.GetRankInformation]"
									parentanchor = vcenter
									blockoverride "Size" { size = { 60 60 } }
									blockoverride "Flag"
									{ 
										texture = "[Country.AccessCoatOfArms.GetTexture('(int32)120', '(int32)120')]"
										frame = "[Country.AccessCoatOfArms.GetFrame('(int32)120', '(int32)120'))]"
										framesize = { 120 120 }
									}
									blockoverride "On_click" { onclick = "[ProvinceWindow.OpenDiplomacy]" }
								}
							}
							textbox = {
								text = "[Country.GetNameWithNoTooltip]"
								size = { 312 40 }
								align = center
								fontsize = 20
								using = BaseFontM
								using = Highlight_FontColor
							}
							icon_card = {
								size = { 195 40 }
								visible = "[GovernmentView.GetPlayer.GetGovernment.IsRepublic]"
								tooltip = "[GovernmentView.GetTermDurationInfo]"
								blockoverride "Icon" { }
								flowcontainer = {
									margin_left = 5
									spacing = 5
									icon_and_text = { #diplomatic reputation
										size = { 80 32 }
										blockoverride "Icon" { texture = "gfx/interface/icons/modifiers/diplomatic_reputation.dds" }
										blockoverride "Text" { text = "[DiplomaticView.GetPlayer.GetModifierValue('diplomatic_reputation')]" }
										tooltip = "DIP_VIEW_REPUTATION_TOOLTIP"
									}
									icon_and_text = { #active diplomatic relations
										size = { 100 32 }
										blockoverride "Icon" { texture = "gfx/interface/icons/modifiers/diplomatic_relations.dds" tooltip = "[DiplomaticView.GetPlayer.GetActiveRelationsInfo]" }
										blockoverride "Text" { text = "[DiplomaticView.GetPlayer.GetNumActiveRelations]/[DiplomaticView.GetPlayer.GetNumActiveRelationsLimit]" }
										tooltip = "[DiplomaticView.GetPlayer.GetModifierTooltip( 'diplomatic_relations' )]"
									}
								}
							}
							flowcontainer = {
								parentanchor = vcenter
								spacing = 5
								flowcontainer = {
									ignoreinvisible = yes
									icon_button_square = {
										size = { 42 42 }
										visible = "[Not(DiplomaticView.IsShowStances)]"
										blockoverride "Icon" { texture = "[GetDiplomaticStanceIcon(DiplomaticView.GetPlayer.GetDiplomaticStance)]" }
										blockoverride "On_click" {
											onclick = "[DiplomaticView.ShowStances]"
										}
									} 
									icon_button_square = {
										size = { 42 42 }
										visible = "[DiplomaticView.IsShowStances]"
										blockoverride "Icon" { texture = "[GetDiplomaticStanceIcon(DiplomaticView.GetPlayer.GetDiplomaticStance)]" }
										blockoverride "On_click" {
											onclick = "[DiplomaticView.HideStances]" 
										}
									}
								}
								flowcontainer = {
									ignoreinvisible = yes
									icon_button_square = {
										size = { 42 42 }
										visible = "[GetVariableSystem.HasValue( 'diplomatic_windows', 'opinions' )]"
										blockoverride "Icon" { texture = "gfx/interface/icons/diplomatic_status/truce.dds" }
										blockoverride "On_click" { onclick = "[GetVariableSystem.Set( 'diplomatic_windows', 'clear' )]" }
										tooltip = "opinionsTT"
									} 
									icon_button_square = {
										size = { 42 42 }
										visible = "[Not(GetVariableSystem.HasValue( 'diplomatic_windows', 'opinions' ))]"
										blockoverride "Icon" { texture = "gfx/interface/icons/diplomatic_status/truce.dds" }
										blockoverride "On_click" { onclick = "[GetVariableSystem.Set( 'diplomatic_windows', 'opinions' )]" } 
										tooltip = "opinionsTT"
									}
								}
							}
						}
					}
					flowcontainer = {
						spacing = 5
						margin = { 5 5 }
						icon_and_text = { #agressive expansion
							size = { 130 32 }
							blockoverride "Icon" { texture = "gfx/interface/icons/modifiers/agressive_expansion_monthly_decay.dds" }
							blockoverride "Text" { text = "[DiplomaticView.GetAEChange |2]" }
							tooltip = "[DiplomaticView.GetAEChangeInfo]"
						}
						icon_and_text = { #agressive expansion impact
							size = { 130 32 }
							blockoverride "Icon" { texture = "gfx/interface/icons/modifiers/agressive_expansion_impact.dds" }
							blockoverride "Text" { text = "[DiplomaticView.GetPlayer.GetModifierValue('agressive_expansion_impact')]" }
							tooltip = "[DiplomaticView.GetPlayer.GetModifierTooltip('agressive_expansion_impact')]"
						}
						icon_and_text = { #improve relation
							size = { 130 32 }
							blockoverride "Icon" { texture = "gfx/interface/icons/modifiers/improve_relation.dds" }
							blockoverride "Text" { text = "[DiplomaticView.GetPlayer.GetModifierValue('improve_relation_impact')]" }
							tooltip = "[DiplomaticView.GetPlayer.GetModifierTooltip('improve_relation_impact')]"
						}
						icon_and_text = { #diplomatic range
							size = { 130 32 }
							blockoverride "Icon" { texture = "gfx/interface/icons/shared_icons/diplomatic_range.dds" }
							blockoverride "Text" { text = "[DiplomaticView.GetDiplomaticRange]" }
							tooltip = "[DiplomaticView.GetDiplomaticRangeTooltip]"
						}
						icon_and_text = { #diplomatic stance change cost
							size = { 130 32 }
							blockoverride "Icon" { texture = "gfx/interface/icons/shared_icons/diplomacy.dds" }
							blockoverride "Text" { text = "[DiplomaticView.GetPlayer.GetModifierValue('change_diplomatic_stance_cost_modifier')]" }
							tooltip = "[DiplomaticView.GetPlayer.GetNumStanceChangesInfo]"
						}
					}
				}
				margin_widget = {
					#size = { 210 128 }
					position = { -5 0 }
					margin = { 5 5 }
					parentanchor = right
					using = background_widget_inner
				}
			}
			widget = {
				size = { 680 2 }
				icon = {
					size = { 684 100 }
					parentanchor = hcenter
					using = shadow_background
					modify_texture = {
						texture = "gfx/interface/base_parts/gradient_black.dds"
						blend_mode = alphamultiply
					}
				}
				icon = {
					size = { @window_width 2 }
					parentanchor = hcenter
					using = brighten_red_background
				}
			}
			margin_widget = {
				size = { 680 225 }
				margin = { 5 5 }
				using = background_widget_inner
				sub_header_v = {   
					size = { 100% 100% }
					blockoverride "Title_text" { text = "diplomatic_player_relationship" }
					blockoverride "Max_text_width" { max_width = 400 }
					scrollarea = {
						size = { 100% 195 }
						position = { 0 35 }
						#using = VerticalScrollAreaCutOff
						scrollbar_vertical = {
							using = VerticalScrollBar
						}
						scrollbarpolicy_horizontal = always_off
						scrollwidget = {
							vbox = {
								margin = { 0 4 }
								vbox = { # trade agreements
									name = "trade_agreements"
									visible = "[Not(IsDataModelEmpty(Player.MakeScope.GetList('list_of_trade_partners_all_categories')))]"
									layoutpolicy_horizontal = expanding 
									layoutpolicy_vertical = shrinking
									margin_right = 12
									margin = { 0 2 }
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = fixed
										ignoreinvisible = yes
										diplomatic_category_icon = {
											blockoverride "Color" { using = green_color }
											margin_widget = {
												size = { 36 36 }
												margin = { 2 2 }
												icon = {
													texture = "gfx/interface/icons/modifiers/commerce_value.dds"
													tooltip = "TRADE_AGREEMENT_TITLE_TT"
													size = { 100% 100% }
												}
											}
										}
										overlappingitembox = {
											margin_right = 14
											datamodel = "[Player.MakeScope.GetList('list_of_trade_partners_all_categories')]"
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = fixed
											size = { 0 30 }
											spacing = 2
											margin_left = 4
											item = {
												new_country_flag = {
													tooltip = "TRADE_AGREEMENT_TT"
													datacontext = "[Scope.GetCountry]"
													blockoverride "Size" { size = { 30 30 } }
													blockoverride "On_click"
													{
														onclick = "[OpenDiplomacy(Country.GetCountry)]"
													}
													blockoverride "Flag" {
														texture = "[Country.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
													blockoverride "FlagOverlord" {
														texture = "[Country.GetOverlord.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.GetOverlord.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
												}
											}
										}
									}
								}
								vbox = { # diplomatic plays
									name = "diplomatic_plays"
									visible = "[Not(IsDataModelEmpty(Player.MakeScope.GetList('list_of_diplomatic_plays_instigated')))]"
									layoutpolicy_horizontal = expanding 
									layoutpolicy_vertical = shrinking
									margin_right = 12
									margin = { 0 2 }
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = fixed
										ignoreinvisible = yes
										diplomatic_category_icon = {
											blockoverride "Color" { using = green_color }
											margin_widget = {
												size = { 36 36 }
												margin = { 2 2 }
												icon = {
													texture = "gfx/interface/icons/modifiers/commerce_value.dds"
													tooltip = "DIPLOMATIC_PLAY_DIPLO_VIEW_TT"
													size = { 100% 100% }
												}
											}
										}
										overlappingitembox = {
											margin_right = 14
											datamodel = "[Player.MakeScope.GetList('list_of_diplomatic_plays_instigated')]"
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = fixed
											size = { 0 30 }
											spacing = 2
											margin_left = 4
											item = {
												new_country_flag = {
													tooltip = "DIPLOMATIC_PLAY_LIST_ITEM_TT"
													datacontext = "[Scope.Var('play_target_country').GetCountry]"
													blockoverride "Size" { size = { 30 30 } }
													blockoverride "On_click"
													{
														onclick = "[OpenDiplomacy(Country.GetCountry)]"
													}
													blockoverride "Flag" {
														texture = "[Country.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
													blockoverride "FlagOverlord" {
														texture = "[Country.GetOverlord.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.GetOverlord.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
												}
											}
										}
									}
								}
								vbox = { # Incoming foreign influence
									name = "foreign_influence_incoming"
									visible = "[Not(IsDataModelEmpty(Player.MakeScope.GetList('DIPLOMACY_list_of_incoming_influencers')))]"
									layoutpolicy_horizontal = expanding 
									layoutpolicy_vertical = shrinking
									margin_right = 12
									margin = { 0 2 }
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = fixed
										ignoreinvisible = yes
										diplomatic_category_icon = {
											blockoverride "Color" { using = green_color }
											margin_widget = {
												size = { 36 36 }
												margin = { 2 2 }
												icon = {
													texture = "gfx/interface/icons/shared_icons/incoming_foreign_influence.dds"
													tooltip = "FOREIGN_INFLUENCE_TITLE_TT"
													size = { 100% 100% }
												}
											}
										}
										overlappingitembox = {
											margin_right = 14
											datamodel = "[DiplomaticView.GetTargetCountry.MakeScope.GetList('DIPLOMACY_list_of_incoming_influencers')]"
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = fixed
											size = { 0 30 }
											spacing = 2
											margin_left = 4
											item = {
												new_country_flag = {
													tooltip = "FOREIGN_INFLUENCE_TT"
													datacontext = "[Scope.GetCountry]"
													blockoverride "Size" { size = { 30 30 } }
													blockoverride "On_click"
													{
														onclick = "[OpenDiplomacy(Country.GetCountry)]"
													}
													blockoverride "Flag" {
														texture = "[Country.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
													blockoverride "FlagOverlord" {
														texture = "[Country.GetOverlord.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.GetOverlord.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
												}
											}
										}
									}
								}
								vbox = { # Outgoing foreign influence
									name = "foreign_influence_outgoing"
									visible = "[Not(IsDataModelEmpty(Player.MakeScope.GetList('DIPLOMACY_list_of_outgoing_influenced_countries')))]"
									layoutpolicy_horizontal = expanding 
									layoutpolicy_vertical = shrinking
									margin_right = 12
									margin = { 0 2 }
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = fixed
										ignoreinvisible = yes
										diplomatic_category_icon = {
											blockoverride "Color" { using = green_color }
											margin_widget = {
												size = { 36 36 }
												margin = { 2 2 }
												icon = {
													texture = "gfx/interface/icons/shared_icons/outgoing_foreign_influence.dds"
													tooltip = "OUTGOING_INFLUENCE_TITLE_TT"
													size = { 100% 100% }
												}
											}
										}
										overlappingitembox = {
											margin_right = 14
											datamodel = "[Player.MakeScope.GetList('DIPLOMACY_list_of_outgoing_influenced_countries')]"
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = fixed
											size = { 0 30 }
											spacing = 2
											margin_left = 4
											item = {
												new_country_flag = {
													tooltip = "OUTGOING_INFLUENCE_TT"
													datacontext = "[Scope.GetCountry]"
													blockoverride "Size" { size = { 30 30 } }
													blockoverride "On_click"
													{
														onclick = "[OpenDiplomacy(Country.GetCountry)]"
													}
													blockoverride "Flag" {
														texture = "[Country.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
													blockoverride "FlagOverlord" {
														texture = "[Country.GetOverlord.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.GetOverlord.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
												}
											}
										}
									}
								}
								vbox = { # war
									name = "war"
									visible = "[Not(IsDataModelEmpty(Player.MakeScope.GetList('player_wars')))]"
									layoutpolicy_horizontal = expanding 
									layoutpolicy_vertical = shrinking
									margin_right = 12
									margin = { 0 2 }
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = fixed
										ignoreinvisible = yes
										diplomatic_category_icon = {
											blockoverride "Color" { using = red_color }
											margin_widget = {
												size = { 36 36 }
												margin = { 2 2 }
												icon = {
													texture = "gfx/interface/icons/diplomatic_status/war.dds"
													tooltip = "diplomatic_status_war_tooltip"
													size = { 100% 100% }
												}
											}
										}
										overlappingitembox = {
											margin_right = 14
											datamodel = "[Player.MakeScope.GetList('player_wars')]"
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = fixed
											size = { 0 30 }
											spacing = 2
											margin_left = 4
											item = {
												new_country_flag = {
													tooltip = "COUNTRY_SHORTHAND_INFO"
													datacontext = "[Scope.GetCountry]"
													blockoverride "Size" { size = { 30 30 } }
													blockoverride "On_click"
													{
														onclick = "[OpenDiplomacy(Country.GetCountry)]"
													}
													blockoverride "Flag" {
														texture = "[Country.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
													blockoverride "FlagOverlord" {
														texture = "[Country.GetOverlord.AccessCoatOfArms.GetTexture('(int32)32','(int32)32')]"
														frame = "[Country.GetOverlord.AccessCoatOfArms.GetFrame('(int32)32','(int32)32')]"
														framesize = { 32 32 }
													}
												}
											}
										}
									}
								}
								vbox = { # alliance
									name = "alliance"
									visible = "[Not(IsDataModelEmpty(Player.MakeScope.GetList('player_alliance')))]"
									layoutpolicy_horizontal = expanding 
									layoutpolicy_vertical = shrinking
									margin_right = 12
									margin = { 0 2 }
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = fixed
										ignoreinvisible = yes
										diplomatic_category_icon = {
											blockoverride "Color" { using = orange_color }
											margin_widget = {
												size = { 36 36 }
												margin = { 2 2 }
												icon = {
													texture = "gfx/interface/icons/diplomatic_status/alliance.dds"
													tooltip = "diplomatic_status_alliance_tooltip"
													size = { 100% 100% }
												}
											}
										}
										overlappingitembox = {
											margin_right = 14
											datamodel = "[Player.MakeScope.GetList('player_alliance')]"
