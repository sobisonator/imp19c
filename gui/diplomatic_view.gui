				margin_widget = {
					size = { 340 545 }
					margin = { 5 5 }
					using = background_widget_inner
					flowcontainer = {
						spacing = 5
						direction = vertical
						sub_header = {
							size = { 330 32 }
							blockoverride "Title_text" { text = "DIPLOMATIC_INTERACTIONS_DIPLO_VIEW" }
						}
						widget = {
							size = { 100% 50 }
							using = background_widget
							flowcontainer = {
								spacing = 5
								margin = { 5 5 }
								icon_card = {
									name = "their_stance"
									visible = "[Not(DiplomaticView.GetTargetCountry.IsBarbarian)]"
									datacontext = "[DiplomaticView.GetTargetCountry.GetDiplomaticStance]"
									blockoverride "Size" { size = { 40 40 } }
									blockoverride "Icon" { texture = "[GetDiplomaticStanceIcon(DiplomaticView.GetTargetCountry.GetDiplomaticStance)]" }
									tooltipwidget = { using = diplomatic_stance_tooltip }
								}
								widget = {
									size = { 280 50 }
									flowcontainer = {
										spacing = 10
										parentanchor = hcenter
										ignoreinvisible = yes
										icon_and_text = {
											size = { 86 35 }
											visible = "[Not(DiplomaticView.GetTargetCountry.IsBarbarian)]"
											tooltip = "[DiplomaticView.GetTargetCountry.GetOpinionDescription(DiplomaticView.GetPlayer)]"
											blockoverride "Icon" { texture = "gfx/interface/icons/diplomatic_status/opinion_improvement_active.dds" }
											blockoverride "Text" { text = "[DiplomaticView.GetTargetCountry.GetOpinionOf(DiplomaticView.GetPlayer)|+=]" }
										}
										icon_and_text = {
											size = { 86 35 }
											visible = "[Not(DiplomaticView.GetTargetCountry.IsBarbarian)]"
											tooltip = "[DiplomaticView.GetPlayer.GetOpinionDescription(DiplomaticView.GetTargetCountry)]"
											blockoverride "Icon" { texture = "gfx/interface/icons/diplomatic_status/opinion_improvement_passive.dds" }
											blockoverride "Text" { text = "[DiplomaticView.GetPlayer.GetOpinionOf(DiplomaticView.GetTargetCountry)|+=]" }
										}
										icon_and_text = {
											size = { 70 35 }
											visible = "[And(Not( DiplomaticView.GetTargetCountry.IsBarbarian), DiplomaticView.GetTargetCountry.IsSubject )]"
											tooltip = "[DiplomaticView.GetTargetCountry.GetSubjectLoyaltyInfo]"
											blockoverride "Icon" { texture = "gfx/interface/icons/shared_icons/loyalty.dds" }
											blockoverride "Text"
											{
												text = "[DiplomaticView.GetTargetCountry.GetSubjectLoyalty|0]"
												visible = "[DiplomaticView.GetTargetCountry.IsSubject]"
											}
											textbox = {
												visible = "[Not(DiplomaticView.GetTargetCountry.IsSubject)]"
												name = "Text"
												position = { 0 3 }
												size = { 100% 24 }					
												align = right 
												elide = right
												using = BaseFontM
												using = Default_FontColor
												margin_right = 6
												text = "NOT_A_SUBJECT_MATE" 
											}
										}
									}
								}
							}
						}
						scrollarea = {
							size = { 330 450 }
							scrollbarpolicy_horizontal = always_off
							scrollbarpolicy_vertical = always_on
							scrollbar_vertical = {
								using = VerticalScrollBar
								blockoverride "Wheelstep" { wheelstep = 34 }
							}
							scrollwidget = {
								vbox = {
									### ???? ###
									vbox = {
										visible = "[DiplomaticView.HasDiplomaticPending]"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = fixed
										using = NoninteractableBG
										blockoverride "Margins" 
										{
											margin = { 2 8 }
										}
									
										textbox = {
											autoresize = yes
											multiline = yes
											maximumsize = { 368 -1 }
											using = BaseFontS
											using = Default_FontColor
											text = "[DiplomaticView.GetDiplomaticPendingText]"
										}
										tooltip = "[DiplomaticView.GetDiplomaticPendingTooltip]"
									}
									### ???? ###
									vbox = {
										solo_action_button_highlighted = { blockoverride "Visible" { visible = "[EqualTo_string(DiplomaticActionItem.GetTitle, Localize('WARTITLE'))]" }
										}
										solo_action_button_highlighted = {
											blockoverride "Visible" { visible = "[EqualTo_string(DiplomaticActionItem.GetTitle, Localize('PEACETITLE'))]" }
											blockoverride "Click" {
												datacontext = "[GetScriptedGui('imp19c_diplo_peace_button')]"
												enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot( DiplomaticView.GetPlayer.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope ).End)]"
												# First onclick: Set a variable in the player scope to store the war in question
												onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( DiplomaticView.GetPlayer.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope).End )]"
												# Second onclick: Set up the war values needed
												onclick = "[GetScriptedGui('alt_peace_button').Execute( GuiScope.SetRoot( DiplomaticView.GetPlayer.MakeScope.Var('peace_window_active_war').War.MakeScope ).AddScope('player', DiplomaticView.GetPlayer.MakeScope ).End )]"
												# Third onclick: Open the peace window, with the war in that variable as the root
												onclick = "[GetVariableSystem.Set( 'alternative_peace_window', 'open' )]"
											}
										}
										solo_action_button = { blockoverride "Visible" { visible = "[EqualTo_string(DiplomaticActionItem.GetTitle, Localize('DEMAND_ACCESSTITLE'))]" }
										}
										solo_action_button = { blockoverride "Visible" { visible = "[EqualTo_string(DiplomaticActionItem.GetTitle, Localize('OFFER_royal_unionTITLE'))]" }
										}
									}
									action_tab = {
										blockoverride "Visible" { visible = "[EqualTo_string(DiplomaticActionCategory.GetName, Localize('ALLIANCE_CATEGORY'))]" }
									}
									action_tab = {
										blockoverride "Visible" { visible = "[EqualTo_string(DiplomaticActionCategory.GetName, Localize('MILACC_CATEGORY'))]" }
									}
									action_tab = {
										blockoverride "Visible" { visible = "[EqualTo_string(DiplomaticActionCategory.GetName, Localize('SELLPROV_CATEGORY'))]" }
									}
									action_tab = {
										blockoverride "Visible" { visible = "[EqualTo_string(DiplomaticActionCategory.GetName, Localize('SUPPORTREBSTOP_CATEGORY'))]" }
									}
									action_tab = {
										blockoverride "Visible" { visible = "[EqualTo_string(DiplomaticActionCategory.GetName, Localize('IMPROVE_RELATION_CATEGORY'))]" }
									}
									action_tab_custom = {
										visible = "[Not(IsDataModelEmpty(DiplomaticView.GetActions))]"
										blockoverride "Visible_close" { visible = "[Not(GetVariableSystem.HasValue( 'trade_actions', 'open' ))]" }
										blockoverride "On_click_open" { onclick = "[GetVariableSystem.Set( 'trade_actions', 'open' )]"  }
										blockoverride "Visible_open" { visible = "[GetVariableSystem.HasValue( 'trade_actions', 'open' )]" }
										blockoverride "On_click_close" { onclick = "[GetVariableSystem.Set( 'trade_actions', 'close' )]" }
										blockoverride "Text" { text = "Trade Actions"  }
										blockoverride "Content" {
											visible = "[And(GetVariableSystem.HasValue( 'trade_actions', 'open' ), And(Not(DiplomaticView.GetTargetCountry.IsBarbarian), Not(EqualTo_int32( DiplomaticView.GetTargetCountry.GetId, Player.GetId ))))]"
											#visible = "[GetVariableSystem.HasValue( 'trade_actions', 'open' )]"
											# Trade agreement - all
											diplomacy_action_button = {
												size = { 315 32 }
												datacontext = "[GetScriptedGui('trade_agreement_all_button')]"
												enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot( Player.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope ).End)]"
												blockoverride "On_click"
												{
													enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Player.MakeScope ).AddScope('recipient', Country.MakeScope).End )]"
													onclick = "[ScriptedGui.Execute(GuiScope.SetRoot( Player.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope ).End)]"
												}
												blockoverride "Left_text" 
												{ 
													margin_left = 24
													text = "[Select_CString( ScriptedGui.IsShown( GuiScope.SetRoot( Player.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope).End ), 'Cancel Trade Agreement', 'Trade Agreement' )]"
												}
												blockoverride "Right_text"
												{
													text = ""
													using = Negative_FontColor
													# Make fontcolor conditional
													tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot( Player.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope ).End)]"
												}	
												blockoverride "Icon" 
												{
													framesize = { 46 46 }
													#visible = "[DiplomaticActionItem.RequireAcceptance]"
													texture = "gfx/interface/base_parts/accept_decline_flat.dds"
													frame = "[Select_int32(ScriptedGui.IsValid(GuiScope.SetRoot( Player.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope ).End),'(int32)2','(int32)1')]"
													tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot( Player.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope ).End)]"
												}	

												tooltip =  "[SelectLocalization( ScriptedGui.IsShown( GuiScope.SetRoot( Player.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope).End ), 'cancel_trade_agreement_all_tt_title', 'offer_trade_agreement_all_tt_title' )]#T [DiplomaticView.GetTargetCountry.GetName] #! [SelectLocalization( ScriptedGui.IsShown( GuiScope.SetRoot( Player.MakeScope ).AddScope('target', DiplomaticView.GetTargetCountry.MakeScope).End ), 'cancel_trade_agreement_all_tt_body', 'offer_trade_agreement_all_tt_body' )]"
											}
										}
									}
									vbox = {
										layoutpolicy_vertical = expanding
									}
								}
							}
						}
					}
				}
			}
		}
	}
	
