				blockoverride "On_click_Sound" {
					clicksound = "event:/SFX/UI/Diplomacy/sfx_ui_diplomacy_trade"
				}
				blockoverride "Details" { visible = "[Not(IsGameViewOpen('trade'))]" }
				blockoverride "Details_toggled" { visible = "[IsGameViewOpen('trade')]" }
				blockoverride "ButtonIcon" { texture = "gfx/interface/icons/menu_buttons/menu_trade.dds" }
			}
