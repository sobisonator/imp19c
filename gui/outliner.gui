				}
				blockoverride "On_click_Sound" {
					clicksound = "event:/SFX/UI/Province/sfx_ui_province_build_building"
				}
				blockoverride "Details" { visible = "[Not(IsGameViewOpen('macro_builder'))]" } 
				blockoverride "Details_toggled" { visible = "[IsGameViewOpen('macro_builder')]" }
