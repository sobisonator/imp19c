		flowcontainer = {
			name = "Buttons_Container"
			direction = vertical
			ignoreinvisible = yes
			allow_outside = yes
			position = { -5 145 }
			topbar_left_button = {
				name = "macro_builder"
				blockoverride "Text" { text = "MACRO_BUILDER" }
				tooltip = "MACRO_BUILDER_MENU"
				blockoverride "On_click" {
					onclick = "[ToggleGameView('macro_builder')]"
